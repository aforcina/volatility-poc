<Window
    x:Class="WinUIClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="Volatility POC" Width="1000" Height="700">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="InstrumentCombo" Width="180" ItemsSource="{x:Bind ViewModel.Instruments}" SelectedItem="{x:Bind ViewModel.SelectedInstrument, Mode=TwoWay}" />
            <Button Content="Fetch Quotes & Compute" Click="OnComputeClick" />
            <Button Content="Cancel" Click="OnCancelClick" Margin="8,0,0,0"/>
            <Button Content="Export" Click="OnExportClick" Margin="8,0,0,0"/>
            <Button Content="Settings" Click="OnSettingsClick" Margin="12,0,0,0"/>
        </StackPanel>

        <ProgressBar Grid.Row="1" x:Name="ProgressBar" Minimum="0" Maximum="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Height="6" Margin="0,8,0,8"/>

        <Grid Grid.Row="2">
            <controls:CanvasControl x:Name="NativeCanvas" Visibility="{x:Bind ViewModel.NativeVisibility, Mode=OneWay}" Draw="NativeCanvas_Draw" />
            <WebView2 x:Name="ChartView" Visibility="{x:Bind ViewModel.WebViewVisibility, Mode=OneWay}" />
        </Grid>

        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusMessage}" Margin="0,8,0,0"/>
    </Grid>
</Window>
