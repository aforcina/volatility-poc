<ContentDialog
    x:Class="WinUIClient.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    PrimaryButtonText="Save"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick">

    <StackPanel Spacing="12" Padding="12">
        <TextBlock Text="Chart display" FontWeight="SemiBold"/>
        <ComboBox x:Name="ChartModeCombo" Width="220"/>
        <TextBlock Text="Chart mode decides whether the application renders the chart using a native Win2D control or a web-based Chart.js inside WebView2." TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
