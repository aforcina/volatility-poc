<ContentDialog
    x:Class="WinUIClient.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    PrimaryButtonText="Save"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick">

    <StackPanel Spacing="12" Padding="12" Width="360">
        <TextBlock Text="Chart display" FontWeight="SemiBold"/>
        <ComboBox x:Name="ChartModeCombo" Width="220"/>
        <TextBlock Text="Chart mode decides whether the application renders the chart using a native Win2D control or a web-based Chart.js inside WebView2." TextWrapping="Wrap"/>

        <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="Theme:"/> 
            <ComboBox x:Name="ThemeCombo" Width="160" />
        </StackPanel>

        <TextBlock Text="Accent color" FontWeight="SemiBold"/>
        <ComboBox x:Name="AccentCombo" Width="260" />

        <TextBlock x:Name="AccentPreview" Text=" " Margin="0,4,0,0"/>
    </StackPanel>
</ContentDialog>
